# --- Google Cloud (BigQuery always; Gemini too when using Vertex AI) ---
# Project that runs (and is billed for) BigQuery jobs and API quota.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# --- Gemini: pick ONE ---
# Option A (simplest): Google AI Studio key -> https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Option B: Vertex AI with your gcloud ADC credentials (leave GOOGLE_API_KEY empty)
# RA_USE_VERTEX=true

# --- Optional: Langfuse tracing (in addition to local JSONL traces) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional: override any config/settings.yaml key with RA_<KEY> ---
# RA_AGENT_MODEL=gemini-3.5-flash
# --- Optional: fault injection to demo resilience (comma separated) ---
# llm_primary | llm_all | guard | bigquery | bigquery_once | embeddings
# RA_FAKE_FAIL=llm_primary
